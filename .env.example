FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me

DATABASE_URL=sqlite:///instance/app.db

# --- Email (used to send password reset links) ---
# Gmail requires an "App Password" — NOT your real Google account
# password. Plain-password SMTP login has been disabled by Google.
#
# 1. Enable 2-Step Verification on the Google account you'll send from:
#    https://myaccount.google.com/security
# 2. Generate an App Password (choose "Mail" as the app):
#    https://myaccount.google.com/apppasswords
# 3. Use that 16-character App Password below — not your normal password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com